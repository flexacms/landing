# Name shown in the logo, footer and SEO tags.
PUBLIC_APP_NAME=Flexa
# Origin of the Flexa app for the /app/login and /app/register links.
# Leave empty when the landing is served from the same host as the app.
PUBLIC_APP_URL=https://app.flexacms.com
# Set to false to hide the sign-in / register calls to action.
PUBLIC_AUTH_ENABLED=true
