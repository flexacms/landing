---
interface Props {
    eyebrow: string;
    title: string;
    description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div data-reveal class="mx-auto max-w-2xl text-center">
    <p class="text-sm font-semibold text-indigo-600 dark:text-indigo-400">
        {eyebrow}
    </p>
    <h2 class="mt-3 text-3xl font-semibold tracking-[-0.03em] text-balance sm:text-4xl">
        {title}
    </h2>
    {
        description && (
            <p class="mt-4 text-lg text-pretty text-zinc-600 dark:text-zinc-400">
                {description}
            </p>
        )
    }
</div>
