---
import { USE_CASES } from '@/lib/site';
import { Building2, Languages, Megaphone, ShoppingBag } from 'lucide-react';
import BentoCard from './BentoCard.astro';
import ExampleCard from './ExampleCard.astro';
import SectionHeading from './SectionHeading.astro';

const icons = [Megaphone, Languages, ShoppingBag, Building2];
---

<section id="use-cases" class="scroll-mt-16 py-28">
    <div class="mx-auto max-w-6xl px-6">
        <SectionHeading
            eyebrow="Use cases"
            title="Built for the content you already manage"
            description="From one landing page to a multilingual store, it's the same editor and the same API."
        />

        <div class="mt-16 grid gap-4 lg:grid-cols-2">
            {
                USE_CASES.map(({ title, description, example }, index) => (
                    <BentoCard
                        icon={icons[index]}
                        order={index % 2}
                        title={title}
                        description={description}
                    >
                        <ExampleCard {...example} />
                    </BentoCard>
                ))
            }
        </div>

        <p
            data-reveal
            class="mt-10 text-center text-sm text-zinc-600 dark:text-zinc-400"
        >
            See each one step by step in the{' '}
            <a
                href="/blog"
                class="font-medium text-zinc-950 underline decoration-zinc-950/20 underline-offset-4 hover:decoration-zinc-950 dark:text-white dark:decoration-white/30 dark:hover:decoration-white"
            >
                use case guides
            </a>.
        </p>
    </div>
</section>
