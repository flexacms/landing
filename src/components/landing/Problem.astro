---
import { revealDelay } from '@/lib/site';
import { Check, FileCode2, MessageSquareText, TriangleAlert, X } from 'lucide-react';
import SectionHeading from './SectionHeading.astro';

const pains = [
    {
        icon: MessageSquareText,
        title: 'A typo fix costs a prompt',
        description:
            'Changing one price means describing it to the AI, waiting, and checking the result.',
    },
    {
        icon: TriangleAlert,
        title: 'Every prompt is a risk',
        description:
            'Ask for a new headline and the AI may also rewrite a section that already worked.',
    },
    {
        icon: FileCode2,
        title: 'Your words live in code',
        description:
            "The copy is buried in files you didn't write, so nobody else on your team can change it.",
    },
];

const comparison = [
    {
        task: 'Change a headline',
        before: 'Write a prompt, wait, check nothing else broke',
        after: 'Edit the field and publish',
    },
    {
        task: 'Fix a mistake',
        before: 'Ask the AI to undo it and hope it remembers',
        after: 'Restore the previous version from history',
    },
    {
        task: 'Let a teammate edit',
        before: 'Share your AI project or your code',
        after: 'Invite them as an editor',
    },
    {
        task: 'Add a second language',
        before: 'Duplicate pages and keep them in sync',
        after: 'Translate fields, with the AI assistant helping',
    },
];
---

<section id="why-flexa" class="scroll-mt-16 py-28">
    <div class="mx-auto max-w-6xl px-6">
        <SectionHeading
            eyebrow="The problem"
            title="Your AI built the site. Now every change is a new prompt."
            description="AI tools are great at building a landing page. Keeping its content up to date is a different job."
        />

        <div class="mt-16 grid gap-4 md:grid-cols-3">
            {
                pains.map(({ icon: Icon, title, description }, index) => (
                    <div
                        data-reveal
                        style={revealDelay(index)}
                        class="rounded-3xl bg-zinc-50 p-7 ring-1 ring-zinc-950/5 dark:bg-white/[0.03] dark:ring-white/10"
                    >
                        <span class="flex size-9 items-center justify-center rounded-xl bg-white text-rose-500 shadow-sm ring-1 ring-zinc-950/5 dark:bg-white/10 dark:text-rose-300 dark:ring-white/10">
                            <Icon className="size-4" />
                        </span>
                        <h3 class="mt-5 font-semibold tracking-tight">{title}</h3>
                        <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                            {description}
                        </p>
                    </div>
                ))
            }
        </div>

        <div
            data-reveal
            class="mt-16 overflow-hidden rounded-3xl ring-1 ring-zinc-950/10 dark:ring-white/10"
        >
            <div class="grid grid-cols-2 border-b border-zinc-950/10 bg-zinc-50 text-sm font-semibold sm:grid-cols-[1fr_1.4fr_1.4fr] dark:border-white/10 dark:bg-white/[0.03]">
                <div class="hidden px-6 py-4 sm:block"></div>
                <div class="px-6 py-4 text-zinc-500">Asking your AI again</div>
                <div class="px-6 py-4 text-indigo-600 dark:text-indigo-400">With Flexa</div>
            </div>
            {
                comparison.map(({ task, before, after }) => (
                    <div class="grid grid-cols-2 border-b border-zinc-950/5 text-sm last:border-0 sm:grid-cols-[1fr_1.4fr_1.4fr] dark:border-white/10">
                        <div class="col-span-2 px-6 pt-4 font-medium sm:col-span-1 sm:py-4">
                            {task}
                        </div>
                        <div class="flex gap-2 px-6 py-4 text-zinc-500">
                            <X className="mt-0.5 size-4 shrink-0 text-rose-400" />
                            {before}
                        </div>
                        <div class="flex gap-2 px-6 py-4 text-zinc-800 dark:text-zinc-200">
                            <Check className="mt-0.5 size-4 shrink-0 text-indigo-500" />
                            {after}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
