---
import { MCP_ABILITIES, MCP_CLIENTS, revealDelay } from '@/lib/site';
import { Bot, Check } from 'lucide-react';
import Brand from './Brand.astro';
---

<section id="mcp" class="scroll-mt-16 px-4 sm:px-6">
    <div
        data-reveal
        class="relative isolate mx-auto max-w-6xl overflow-hidden rounded-[2rem] bg-zinc-950 px-6 py-16 text-white ring-1 ring-white/10 sm:px-12 lg:py-20"
    >
        <div
            aria-hidden="true"
            class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgb(255_255_255/0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgb(255_255_255/0.04)_1px,transparent_1px)] [mask-image:radial-gradient(ellipse_60%_60%_at_70%_40%,black,transparent)] bg-[size:40px_40px]"
        >
        </div>
        <div
            aria-hidden="true"
            class="absolute -top-40 -right-40 -z-10 size-[36rem] animate-float rounded-full bg-[radial-gradient(closest-side,rgb(139_92_246/0.35),transparent)]"
        >
        </div>
        <div
            aria-hidden="true"
            class="absolute -bottom-48 -left-40 -z-10 size-[32rem] animate-float rounded-full bg-[radial-gradient(closest-side,rgb(99_102_241/0.25),transparent)] [animation-delay:-3s] [animation-direction:reverse]"
        >
        </div>

        <div class="grid items-center gap-14 lg:grid-cols-2">
            <div>
                <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-indigo-200 ring-1 ring-white/10">
                    <Bot className="size-3.5" /> For AI tools (MCP)
                </span>
                <h2 class="mt-6 text-3xl font-semibold tracking-[-0.03em] text-balance sm:text-4xl">
                    Prefer chatting? Ask your AI to change it.
                </h2>
                <p class="mt-4 text-lg text-zinc-400">
                    Connect Claude, Cursor or VS Code to Flexa, then just say
                    “change the price to €29 and publish”. It edits your content,
                    not your code, so nothing else on the page changes. Each
                    API key decides what the AI can do, and every change can be
                    undone.
                </p>
                <ul class="mt-8 flex flex-wrap gap-2">
                    {
                        MCP_CLIENTS.map(({ name, icon }, index) => (
                            <li
                                data-reveal
                                style={revealDelay(index + 3)}
                                class="flex items-center gap-2 rounded-full bg-white/5 py-1.5 ps-2 pe-3.5 text-sm text-zinc-200 ring-1 ring-white/10 transition hover:-translate-y-0.5 hover:bg-white/10 hover:ring-white/20"
                            >
                                <Brand icon={icon} class="size-4" />
                                {name}
                            </li>
                        ))
                    }
                </ul>
            </div>

            <ul class="space-y-3">
                {
                    MCP_ABILITIES.map(({ ability, tools }, index) => (
                        <li
                            data-reveal
                            style={revealDelay(index + 2, 120)}
                            class="group flex gap-4 rounded-2xl bg-white/[0.04] p-5 ring-1 ring-white/10 backdrop-blur transition duration-300 hover:translate-x-1 hover:bg-white/[0.07] hover:ring-indigo-400/30"
                        >
                            <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-indigo-500/20 text-indigo-300 transition duration-300 group-hover:scale-110 group-hover:bg-indigo-500/40">
                                <Check className="size-3.5" />
                            </span>
                            <div>
                                <p class="font-medium">{ability}</p>
                                <p class="mt-1 text-sm text-zinc-400">
                                    {tools}
                                </p>
                            </div>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>
