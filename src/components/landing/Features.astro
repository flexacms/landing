---
import { FIELD_TYPES } from '@/lib/site';
import {
    Blocks,
    History,
    KeyRound,
    Languages,
    Sparkles,
    Users,
    Zap,
} from 'lucide-react';
import BentoCard from './BentoCard.astro';
import SectionHeading from './SectionHeading.astro';
---

<section id="features" class="scroll-mt-16 py-28">
    <div class="mx-auto max-w-6xl px-6">
        <SectionHeading
            eyebrow="Features"
            title="Everything you need to keep your site up to date"
            description="Simple enough for anyone on your team, solid enough for your developer."
        />

        <div class="mt-16 grid gap-4 lg:grid-cols-6">
            <BentoCard
                icon={Blocks}
                title="Decide what's editable"
                description="Headlines, images, prices, lists, links: pick what your team can change, from a visual builder with 20+ field types."
                class="lg:col-span-4"
            >
                <div class="flex flex-wrap gap-2">
                    {
                        FIELD_TYPES.map((type, index) => (
                            <span
                                style={`transition-delay: ${index * 30}ms`}
                                class="rounded-full bg-white px-3 py-1 text-xs font-medium text-zinc-600 ring-1 ring-zinc-950/5 transition duration-300 group-hover:-translate-y-0.5 group-hover:ring-indigo-500/20 dark:bg-white/5 dark:text-zinc-300 dark:ring-white/10 dark:group-hover:ring-indigo-400/30"
                            >
                                {type}
                            </span>
                        ))
                    }
                </div>
            </BentoCard>

            <BentoCard
                icon={Zap}
                order={1}
                title="Works with any site"
                description="Your website or app loads its content from Flexa with one request, whatever it was built with."
                class="lg:col-span-2"
            >
                <div class="space-y-1.5 font-mono text-xs">
                    {
                        [
                            ['GET', '/api/v1/{entity}'],
                            ['POST', '/api/v1/{entity}'],
                            ['GET', '/api/v1/{entity}/schema'],
                        ].map(([method, path]) => (
                            <div class="flex gap-3 rounded-lg bg-white px-3 py-2 ring-1 ring-zinc-950/5 transition duration-300 group-hover:translate-x-1 last:delay-150 even:delay-75 dark:bg-white/5 dark:ring-white/10">
                                <span class="w-9 font-semibold text-indigo-600 dark:text-indigo-400">
                                    {method}
                                </span>
                                <span class="text-zinc-500">{path}</span>
                            </div>
                        ))
                    }
                </div>
            </BentoCard>

            <BentoCard
                icon={Sparkles}
                order={2}
                title="AI assistant"
                description="Ask it to draft a post, translate an entry or set up a new content type. Risky actions wait for your approval."
                class="lg:col-span-2"
            />

            <BentoCard
                icon={KeyRound}
                order={3}
                title="Control who can do what"
                description="Give each site, app or tool its own API key. Limit it to the content it needs and set an expiry date."
                class="lg:col-span-2"
            />

            <BentoCard
                icon={Users}
                order={4}
                title="Separate projects, shared team"
                description="Every project lives in its own isolated workspace. Invite owners, admins, editors and viewers."
                class="lg:col-span-2"
            />

            <BentoCard
                icon={Languages}
                order={5}
                title="Multilingual from day one"
                description="Translate any field and get each language from the same API. The AI assistant can write in every language."
                class="lg:col-span-3"
            />

            <BentoCard
                icon={History}
                order={6}
                title="Undo any change"
                description="Every edit, whether it comes from the editor, the API or an AI tool, is saved in a history you can restore."
                class="lg:col-span-3"
            />
        </div>
    </div>
</section>
