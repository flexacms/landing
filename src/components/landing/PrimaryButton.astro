---
import { ArrowRight } from 'lucide-react';

interface Props {
    href: string;
    shine?: boolean;
}

const { href, shine = true } = Astro.props;
---

<a
    href={href}
    class="group relative inline-flex h-11 items-center gap-2 overflow-hidden rounded-full bg-zinc-950 px-6 text-sm font-medium text-white shadow-lg shadow-indigo-500/20 transition duration-300 hover:-translate-y-0.5 hover:bg-zinc-800 hover:shadow-xl hover:shadow-indigo-500/30 dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-200"
>
    {
        shine && (
            <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-y-0 left-0 w-1/3 -translate-x-[120%] skew-x-[-20deg] bg-gradient-to-r from-transparent via-white/25 to-transparent transition-transform duration-700 group-hover:translate-x-[320%] dark:via-zinc-950/10"
            />
        )
    }
    <slot />
    <ArrowRight className="size-4 transition group-hover:translate-x-0.5" />
</a>
