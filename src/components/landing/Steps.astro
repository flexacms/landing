---
import { revealDelay, STEPS } from '@/lib/site';
import SectionHeading from './SectionHeading.astro';
---

<section class="border-y border-zinc-950/5 bg-zinc-50/70 py-28 dark:border-white/5 dark:bg-white/[0.015]">
    <div class="mx-auto max-w-6xl px-6">
        <SectionHeading
            eyebrow="How it works"
            title="From idea to live content in minutes"
        />
        <div data-reveal class="relative mt-16">
            <div
                aria-hidden="true"
                class="reveal-line absolute top-5 right-[16%] left-[16%] hidden h-px bg-gradient-to-r from-transparent via-indigo-500/50 to-transparent md:block dark:via-indigo-400/50"
            >
            </div>
            <ol class="grid gap-10 md:grid-cols-3 md:gap-8">
                {
                    STEPS.map(({ title, description }, index) => (
                        <li
                            data-reveal
                            style={revealDelay(index, 150)}
                            class="group relative text-center"
                        >
                            <span class="relative mx-auto flex size-10 items-center justify-center rounded-full bg-white font-mono text-sm font-semibold shadow-sm ring-1 ring-zinc-950/10 transition duration-500 group-hover:scale-110 group-hover:text-indigo-600 group-hover:ring-indigo-500/40 dark:bg-zinc-900 dark:ring-white/15 dark:group-hover:text-indigo-300">
                                {String(index + 1).padStart(2, '0')}
                            </span>
                            <h3 class="mt-6 font-semibold tracking-tight">
                                {title}
                            </h3>
                            <p class="mx-auto mt-2 max-w-xs text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                                {description}
                            </p>
                        </li>
                    ))
                }
            </ol>
        </div>
    </div>
</section>
