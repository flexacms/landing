---
import { STACK } from '@/lib/site';
import Brand from './Brand.astro';
---

<section class="border-y border-zinc-950/5 py-10 dark:border-white/5">
    <div class="mx-auto max-w-6xl px-6">
        <p class="text-center text-xs font-medium tracking-[0.2em] text-zinc-500 uppercase">
            Delivers content to the stack you already use
        </p>
        <div class="marquee-mask group mt-6 flex overflow-hidden">
            {
                [false, true].map((isDuplicate) => (
                    <ul
                        aria-hidden={isDuplicate ? 'true' : undefined}
                        class="flex shrink-0 animate-marquee items-center gap-x-12 pe-12 group-hover:[animation-play-state:paused]"
                    >
                        {STACK.map(({ name, icon }) => (
                            <li class="flex items-center gap-2.5 text-lg font-semibold tracking-tight whitespace-nowrap text-zinc-400 transition hover:text-zinc-950 dark:text-zinc-500 dark:hover:text-white">
                                <Brand icon={icon} class="size-6" />
                                {name}
                            </li>
                        ))}
                    </ul>
                ))
            }
        </div>
    </div>
</section>
