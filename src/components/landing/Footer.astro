---
import Logo from '@/components/react/logo';
import { appUrl, NAV_LINKS } from '@/lib/site';

interface Props {
    name: string;
    isAuthEnabled?: boolean;
}

const { name, isAuthEnabled = true } = Astro.props;

const columns = [
    {
        title: 'Product',
        links: NAV_LINKS,
    },
    {
        title: 'Developers',
        links: [
            {
                label: 'SDKs on GitHub',
                href: 'https://github.com/flexacms/sdk',
            },
            ...(isAuthEnabled
                ? [
                      {
                          label: 'Create a workspace',
                          href: appUrl('/app/register'),
                      },
                      { label: 'Sign in', href: appUrl('/app/login') },
                  ]
                : []),
        ],
    },
];
---

<footer class="border-t border-zinc-950/5 dark:border-white/5">
    <div class="mx-auto flex max-w-6xl flex-col gap-10 px-6 py-14 sm:flex-row sm:justify-between">
        <div class="max-w-xs">
            <Logo name={name} />
            <p class="mt-4 text-sm leading-relaxed text-zinc-500">
                The headless CMS for websites, apps and AI agents.
            </p>
        </div>
        <div class="grid grid-cols-2 gap-12 text-sm sm:gap-20">
            {
                columns.map(({ title, links }) => (
                    <div>
                        <p class="font-medium">{title}</p>
                        <ul class="mt-4 space-y-3 text-zinc-500">
                            {links.map(({ label, href }) => (
                                <li>
                                    <a
                                        href={href}
                                        class="transition hover:text-zinc-950 dark:hover:text-white"
                                    >
                                        {label}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </div>
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 border-t border-zinc-950/5 px-6 py-6 text-xs text-zinc-500 sm:flex-row dark:border-white/5">
        <p>
            © {new Date().getFullYear()} {name}. All rights reserved.
        </p>
        <p>Built with Laravel, Filament and FlexFields.</p>
    </div>
</footer>
