---
import AppearanceToggle from '@/components/react/appearance-toggle';
import Logo from '@/components/react/logo';
import { appUrl, NAV_LINKS } from '@/lib/site';

interface Props {
    name: string;
    isAuthEnabled?: boolean;
}

const { name, isAuthEnabled = true } = Astro.props;
---

<header
    data-site-header
    class="sticky top-0 z-50 border-b border-transparent bg-white/0 backdrop-blur-xl transition-[background-color,border-color,box-shadow] duration-500 dark:bg-zinc-950/0"
>
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
        <div class="flex items-center gap-10">
            <Logo name={name} />
            <nav class="hidden items-center gap-7 text-sm text-zinc-600 md:flex dark:text-zinc-400">
                {
                    NAV_LINKS.map(({ label, href }) => (
                        <a
                            href={href}
                            class="relative transition after:absolute after:inset-x-0 after:-bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-current after:transition-transform after:duration-300 hover:text-zinc-950 hover:after:scale-x-100 dark:hover:text-white"
                        >
                            {label}
                        </a>
                    ))
                }
            </nav>
        </div>
        <div class="flex items-center gap-2 text-sm">
            <AppearanceToggle client:load />
            {
                isAuthEnabled && (
                    <>
                        <a
                            href={appUrl('/app/login')}
                            class="hidden rounded-full px-4 py-1.5 font-medium text-zinc-600 transition hover:text-zinc-950 sm:inline-flex dark:text-zinc-400 dark:hover:text-white"
                        >
                            Sign in
                        </a>
                        <a
                            href={appUrl('/app/register')}
                            class="rounded-full bg-zinc-950 px-4 py-1.5 font-medium text-white shadow-sm transition hover:-translate-y-px hover:bg-zinc-800 active:translate-y-0 dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-200"
                        >
                            Start free
                        </a>
                    </>
                )
            }
        </div>
    </div>
</header>

<script>
    const SCROLLED = [
        'border-zinc-950/5',
        'bg-white/80',
        'shadow-[0_8px_30px_-12px_rgb(9_9_11/0.12)]',
        'dark:border-white/5',
        'dark:bg-zinc-950/80',
    ];
    const RESTING = ['border-transparent', 'bg-white/0', 'dark:bg-zinc-950/0'];

    const header = document.querySelector<HTMLElement>('[data-site-header]');

    if (header) {
        const updateScrolled = () => {
            const isScrolled = window.scrollY > 8;

            header.classList.remove(...(isScrolled ? RESTING : SCROLLED));
            header.classList.add(...(isScrolled ? SCROLLED : RESTING));
        };

        updateScrolled();
        window.addEventListener('scroll', updateScrolled, { passive: true });
    }
</script>
