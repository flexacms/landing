---
import { revealDelay } from '@/lib/site';
import { ArrowRight, Building2, Code2, PenLine } from 'lucide-react';
import ExampleCard from './ExampleCard.astro';
import SectionHeading from './SectionHeading.astro';

const audiences = [
    {
        icon: Code2,
        title: 'Developers',
        description:
            'Stop hardcoding text, prices and images. Model the content once and read it through a typed API and SDKs.',
    },
    {
        icon: PenLine,
        title: 'Marketing and content teams',
        description:
            'Update pages, posts and products yourself, in every language, with a history you can undo.',
    },
    {
        icon: Building2,
        title: 'Agencies',
        description:
            'One workspace per client, with roles for who edits and who reviews, and keys you can revoke.',
    },
];
---

<section id="what-is-flexa" class="scroll-mt-16 py-28">
    <div class="mx-auto max-w-6xl px-6">
        <SectionHeading
            eyebrow="What Flexa does"
            title="Your team edits the content. Your site shows it."
            description="Flexa is a headless CMS: the place where your website's or app's content lives. Developers connect it once, and after that nobody needs to touch code to change a headline, a price or a blog post."
        />

        <div class="mt-16 grid items-stretch gap-4 lg:grid-cols-[1fr_auto_1fr_auto_1fr]">
            <div data-reveal style={revealDelay(0)} class="flex flex-col rounded-3xl bg-zinc-50 p-6 ring-1 ring-zinc-950/5 dark:bg-white/[0.03] dark:ring-white/10">
                <p class="font-mono text-xs text-indigo-600 dark:text-indigo-400">01</p>
                <h3 class="mt-2 font-semibold tracking-tight">Your team writes</h3>
                <p class="mt-1.5 text-sm text-zinc-600 dark:text-zinc-400">
                    Editors, marketers or an AI tool update content in the Flexa editor.
                </p>
                <div class="mt-auto pt-5">
                    <ExampleCard
                        heading="Promo · Winter membership"
                        status="Draft"
                        rows={[
                            { label: 'headline', value: 'Climb all winter' },
                            { label: 'price', value: '€49/month' },
                        ]}
                    />
                </div>
            </div>

            <ArrowRight aria-hidden="true" className="mx-auto size-5 rotate-90 self-center text-zinc-400 lg:rotate-0" />

            <div data-reveal style={revealDelay(1)} class="flex flex-col rounded-3xl bg-zinc-50 p-6 ring-1 ring-zinc-950/5 dark:bg-white/[0.03] dark:ring-white/10">
                <p class="font-mono text-xs text-indigo-600 dark:text-indigo-400">02</p>
                <h3 class="mt-2 font-semibold tracking-tight">Flexa stores and serves it</h3>
                <p class="mt-1.5 text-sm text-zinc-600 dark:text-zinc-400">
                    Every change is saved with history and delivered through a secure API.
                </p>
                <div class="mt-auto pt-5">
                    <div class="rounded-xl bg-zinc-950 p-4 font-mono text-xs leading-relaxed text-zinc-300 ring-1 ring-white/10">
                        <span class="text-indigo-300">GET</span> /api/v1/promos
                        <br />
                        <span class="text-zinc-500">→</span> {'{ "headline": "Climb all winter" }'}
                    </div>
                </div>
            </div>

            <ArrowRight aria-hidden="true" className="mx-auto size-5 rotate-90 self-center text-zinc-400 lg:rotate-0" />

            <div data-reveal style={revealDelay(2)} class="flex flex-col rounded-3xl bg-zinc-50 p-6 ring-1 ring-zinc-950/5 dark:bg-white/[0.03] dark:ring-white/10">
                <p class="font-mono text-xs text-indigo-600 dark:text-indigo-400">03</p>
                <h3 class="mt-2 font-semibold tracking-tight">Your site or app shows it</h3>
                <p class="mt-1.5 text-sm text-zinc-600 dark:text-zinc-400">
                    Your website, mobile app, WordPress site or AI agent reads the same content.
                </p>
                <div class="mt-auto pt-5">
                    <div class="rounded-xl bg-white p-4 ring-1 ring-zinc-950/5 dark:bg-white/5 dark:ring-white/10">
                        <p class="text-[11px] font-medium text-indigo-600 dark:text-indigo-300">€49/month</p>
                        <p class="mt-1 text-base font-semibold tracking-tight">Climb all winter</p>
                        <span class="mt-3 inline-flex rounded-full bg-zinc-950 px-3 py-1 text-[11px] font-medium text-white dark:bg-white dark:text-zinc-950">
                            Book now
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-16 grid gap-8 border-t border-zinc-950/5 pt-12 md:grid-cols-3 dark:border-white/10">
            {
                audiences.map(({ icon: Icon, title, description }, index) => (
                    <div data-reveal style={revealDelay(index)}>
                        <span class="flex size-9 items-center justify-center rounded-xl bg-white shadow-sm ring-1 ring-zinc-950/5 dark:bg-white/10 dark:ring-white/10">
                            <Icon className="size-4" />
                        </span>
                        <h3 class="mt-4 font-semibold tracking-tight">
                            For {title.toLowerCase()}
                        </h3>
                        <p class="mt-1.5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                            {description}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
