---
import { getCollection } from 'astro:content';
import Footer from '@/components/landing/Footer.astro';
import Header from '@/components/landing/Header.astro';
import MobileMenu from '@/components/react/mobile-menu';
import Layout from '@/layouts/Layout.astro';
import { APP_NAME, IS_AUTH_ENABLED } from '@/lib/site';
import { ArrowRight } from 'lucide-react';

const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const slugify = (value: string) =>
    value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const categories = [...new Set(posts.map((post) => post.data.tag))].map(
    (name) => ({
        name,
        slug: slugify(name),
        count: posts.filter((post) => post.data.tag === name).length,
    }),
);

const formatDate = (date: Date) =>
    date.toLocaleDateString('en', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        timeZone: 'UTC',
    });
---

<Layout
    title="Blog"
    description="Tutorials and real-world scenarios for Flexa: campaign pages, multilingual blogs, product catalogs, agency workspaces and AI-assisted content cleanup."
>
    <div class="relative min-h-screen overflow-x-clip bg-white text-zinc-950 antialiased selection:bg-indigo-500/20 dark:bg-zinc-950 dark:text-white">
        <Header name={APP_NAME} isAuthEnabled={IS_AUTH_ENABLED} />

        <main class="mx-auto max-w-6xl px-6 pt-32 pb-28">
            <p class="text-sm font-semibold text-indigo-600 dark:text-indigo-400">
                Blog
            </p>
            <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-[-0.03em] text-balance sm:text-5xl">
                Real ways to use Flexa
            </h1>
            <p class="mt-5 max-w-2xl text-lg text-zinc-600 dark:text-zinc-400">
                Tutorials and step-by-step scenarios for the work teams do every
                week.
            </p>

            <div
                role="group"
                aria-label="Filter by category"
                class="mt-12 flex flex-wrap gap-2"
                data-filters
            >
                <button
                    type="button"
                    data-category="all"
                    aria-pressed="true"
                    class="filter-chip"
                >
                    All <span class="filter-count">{posts.length}</span>
                </button>
                {
                    categories.map(({ name, slug, count }) => (
                        <button
                            type="button"
                            data-category={slug}
                            aria-pressed="false"
                            class="filter-chip"
                        >
                            {name} <span class="filter-count">{count}</span>
                        </button>
                    ))
                }
            </div>

            <ul class="mt-10 grid gap-x-8 gap-y-4 md:grid-cols-2 lg:grid-cols-3" data-posts>
                {
                    posts.map((post) => (
                        <li
                            data-category={slugify(post.data.tag)}
                            class="group relative flex flex-col rounded-2xl border border-zinc-950/10 p-6 transition hover:border-zinc-950/20 hover:bg-zinc-50 dark:border-white/10 dark:hover:border-white/20 dark:hover:bg-white/[0.03]"
                        >
                            <p class="text-xs font-medium text-indigo-600 dark:text-indigo-400">
                                {post.data.tag}
                            </p>
                            <h2 class="mt-3 text-lg leading-snug font-semibold tracking-tight text-balance">
                                <a
                                    href={`/blog/${post.id}`}
                                    class="after:absolute after:inset-0 focus-visible:outline-none"
                                >
                                    {post.data.title}
                                </a>
                            </h2>
                            <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                                {post.data.description}
                            </p>
                            <div class="mt-auto flex items-center justify-between pt-6 text-xs text-zinc-500">
                                <time datetime={post.data.pubDate.toISOString()}>
                                    {formatDate(post.data.pubDate)}
                                </time>
                                <span class="flex items-center gap-1 font-medium text-zinc-950 transition group-hover:gap-1.5 dark:text-white">
                                    Read
                                    <ArrowRight className="size-3.5" />
                                </span>
                            </div>
                        </li>
                    ))
                }
            </ul>

            <p class="mt-10 text-sm text-zinc-500">
                The businesses in the scenarios are fictional. The workflows use
                real Flexa features.
            </p>
        </main>

        <Footer name={APP_NAME} isAuthEnabled={IS_AUTH_ENABLED} />

        <MobileMenu
            client:load
            name={APP_NAME}
            isAuthEnabled={IS_AUTH_ENABLED}
        />
    </div>
</Layout>

<style>
    .filter-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        border-radius: 9999px;
        padding: 0.375rem 0.875rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: rgb(63 63 70);
        box-shadow: inset 0 0 0 1px rgb(9 9 11 / 0.1);
        transition:
            background-color 150ms,
            color 150ms;
        cursor: pointer;
    }
    .filter-chip:hover {
        background-color: rgb(9 9 11 / 0.04);
    }
    .filter-chip[aria-pressed='true'] {
        background-color: rgb(9 9 11);
        color: white;
        box-shadow: none;
    }
    .filter-count {
        font-size: 0.75rem;
        opacity: 0.6;
    }
    :global(.dark) .filter-chip {
        color: rgb(212 212 216);
        box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.15);
    }
    :global(.dark) .filter-chip:hover {
        background-color: rgb(255 255 255 / 0.05);
    }
    :global(.dark) .filter-chip[aria-pressed='true'] {
        background-color: white;
        color: rgb(9 9 11);
    }
</style>

<script>
    /**
     * Filters the post grid by category. Every post stays visible without JS;
     * the selected category is kept in `?category=` so a filtered view can be
     * shared.
     */
    const buttons = document.querySelectorAll<HTMLButtonElement>(
        '[data-filters] button',
    );
    const posts = document.querySelectorAll<HTMLElement>('[data-posts] > li');

    const select = (category: string) => {
        const known = [...buttons].some((b) => b.dataset.category === category);
        const active = known ? category : 'all';

        buttons.forEach((button) =>
            button.setAttribute(
                'aria-pressed',
                String(button.dataset.category === active),
            ),
        );
        posts.forEach((post) => {
            post.hidden = active !== 'all' && post.dataset.category !== active;
        });

        const url = new URL(window.location.href);

        if (active === 'all') {
            url.searchParams.delete('category');
        } else {
            url.searchParams.set('category', active);
        }

        history.replaceState(null, '', url);
    };

    buttons.forEach((button) =>
        button.addEventListener('click', () =>
            select(button.dataset.category ?? 'all'),
        ),
    );

    select(new URLSearchParams(window.location.search).get('category') ?? 'all');
</script>
