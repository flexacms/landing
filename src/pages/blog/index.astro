---
import { getCollection } from 'astro:content';
import Footer from '@/components/landing/Footer.astro';
import Header from '@/components/landing/Header.astro';
import MobileMenu from '@/components/react/mobile-menu';
import Layout from '@/layouts/Layout.astro';
import { APP_NAME, IS_AUTH_ENABLED } from '@/lib/site';

const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (date: Date) =>
    date.toLocaleDateString('en', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        timeZone: 'UTC',
    });
---

<Layout
    title="Blog"
    description="Real ways to use Flexa: campaign pages, multilingual blogs, product catalogs, agency workspaces and AI-assisted content cleanup."
>
    <div class="relative min-h-screen overflow-x-clip bg-white text-zinc-950 antialiased selection:bg-indigo-500/20 dark:bg-zinc-950 dark:text-white">
        <Header name={APP_NAME} isAuthEnabled={IS_AUTH_ENABLED} />

        <main class="mx-auto max-w-6xl px-6 pt-32 pb-28">
            <p class="text-sm font-semibold text-indigo-600 dark:text-indigo-400">
                Blog
            </p>
            <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-[-0.03em] text-balance sm:text-5xl">
                Real ways to use Flexa
            </h1>
            <p class="mt-5 max-w-2xl text-lg text-zinc-600 dark:text-zinc-400">
                Step-by-step guides for the work teams do every week: launching
                pages, translating content, running a store catalog, managing
                client sites and letting AI help with cleanup.
            </p>

            <ul class="mt-16 grid gap-6 md:grid-cols-2">
                {
                    posts.map((post) => (
                        <li class="group relative flex flex-col rounded-3xl bg-zinc-50 p-7 ring-1 ring-zinc-950/5 transition hover:shadow-xl hover:shadow-indigo-500/5 hover:ring-zinc-950/10 dark:bg-white/[0.03] dark:ring-white/10 dark:hover:ring-white/20">
                            <div class="flex items-center justify-between text-xs text-zinc-500">
                                <span class="rounded-full bg-indigo-500/10 px-2.5 py-0.5 font-medium text-indigo-600 dark:text-indigo-300">
                                    {post.data.tag}
                                </span>
                                <time datetime={post.data.pubDate.toISOString()}>
                                    {formatDate(post.data.pubDate)}
                                </time>
                            </div>
                            <h2 class="mt-5 text-xl font-semibold tracking-tight">
                                <a href={`/blog/${post.id}`} class="after:absolute after:inset-0 hover:text-indigo-600 dark:hover:text-indigo-300">
                                    {post.data.title}
                                </a>
                            </h2>
                            <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                                {post.data.description}
                            </p>
                        </li>
                    ))
                }
            </ul>
        </main>

        <Footer name={APP_NAME} isAuthEnabled={IS_AUTH_ENABLED} />

        <MobileMenu
            client:load
            name={APP_NAME}
            isAuthEnabled={IS_AUTH_ENABLED}
        />
    </div>
</Layout>
