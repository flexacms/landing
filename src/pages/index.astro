---
import Faq from '@/components/landing/Faq.astro';
import Features from '@/components/landing/Features.astro';
import FinalCta from '@/components/landing/FinalCta.astro';
import Footer from '@/components/landing/Footer.astro';
import Header from '@/components/landing/Header.astro';
import Hero from '@/components/landing/Hero.astro';
import Integrations from '@/components/landing/Integrations.astro';
import Mcp from '@/components/landing/Mcp.astro';
import StackStrip from '@/components/landing/StackStrip.astro';
import Steps from '@/components/landing/Steps.astro';
import UseCases from '@/components/landing/UseCases.astro';
import MobileMenu from '@/components/react/mobile-menu';
import Layout from '@/layouts/Layout.astro';
import { APP_NAME, IS_AUTH_ENABLED } from '@/lib/site';
---

<Layout>
    <div
        data-landing
        class="relative min-h-screen overflow-x-clip bg-white text-zinc-950 antialiased selection:bg-indigo-500/20 dark:bg-zinc-950 dark:text-white"
    >
        <Header name={APP_NAME} isAuthEnabled={IS_AUTH_ENABLED} />

        <main>
            <Hero isAuthEnabled={IS_AUTH_ENABLED} />
            <StackStrip />
            <Features />
            <Steps />
            <UseCases />
            <Integrations />
            <Mcp />
            <Faq />
            <FinalCta isAuthEnabled={IS_AUTH_ENABLED} />
        </main>

        <Footer name={APP_NAME} isAuthEnabled={IS_AUTH_ENABLED} />

        <MobileMenu
            client:load
            name={APP_NAME}
            isAuthEnabled={IS_AUTH_ENABLED}
        />
    </div>
</Layout>

<script>
    /**
     * Opts the page into scroll-reveal motion and marks every `data-reveal`
     * element as revealed the first time it scrolls into view. Content stays
     * visible without JS because the hidden state needs `data-motion`.
     */
    const container = document.querySelector<HTMLElement>('[data-landing]');

    if (container && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-revealed');
                        observer.unobserve(entry.target);
                    }
                }
            },
            { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );

        container.setAttribute('data-motion', '');
        container
            .querySelectorAll<HTMLElement>('[data-reveal]')
            .forEach((target) => observer.observe(target));
    }

    /** Moves the `.spotlight` glow to follow the pointer inside the element. */
    document.querySelectorAll<HTMLElement>('.spotlight').forEach((element) => {
        element.addEventListener('mousemove', (event) => {
            const bounds = element.getBoundingClientRect();

            element.style.setProperty('--spot-x', `${event.clientX - bounds.left}px`);
            element.style.setProperty('--spot-y', `${event.clientY - bounds.top}px`);
        });
    });
</script>
